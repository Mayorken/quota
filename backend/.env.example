# Copy to .env and adjust. Local dev works with no changes (uses SQLite).
PORT=8080

# Leave DATABASE_URL empty for local SQLite dev.
# For Supabase/Postgres, set the connection string:
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

SQLITE_PATH=quota.db
JWT_SECRET=dev-insecure-secret-change-me
CORS_ORIGIN=http://localhost:5173

# Google Sign-In (optional). Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials and add
# your frontend origin (e.g. http://localhost:5173) to "Authorized JavaScript
# origins". Leave empty to disable Google sign-in and use email/password only.
GOOGLE_CLIENT_ID=
